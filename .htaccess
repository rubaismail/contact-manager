<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the production host to one HTTPS canonical origin. The www
    # certificate must include www.team11.store before that hostname is used.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?team11\.store$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://team11.store%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.team11\.store$ [NC]
    RewriteRule ^ https://team11.store%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_alias.c>
    RedirectMatch 302 ^/favicon\.ico$ /favicon.svg
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>
